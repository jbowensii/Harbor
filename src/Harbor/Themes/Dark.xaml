<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Palette - the same warm ink language after dark.

         Not a neon terminal: the ground is a warm charcoal with a
         brown cast rather than blue-black, the text is a soft bone
         white, and the accent is the light-mode slate lifted enough
         to sit on a dark ground. Status colours are the same four
         pigments, desaturated and lightened so they read on charcoal
         without glowing.

         Every key here also exists in Light.xaml. Swapping the two
         dictionaries is the whole of theme switching, which is why
         the views bind these with DynamicResource.
         ============================================================ -->

    <SolidColorBrush x:Key="Canvas"        Color="#191816"/>
    <SolidColorBrush x:Key="Surface"       Color="#211F1C"/>
    <SolidColorBrush x:Key="SurfaceSunken" Color="#141312"/>
    <SolidColorBrush x:Key="SurfaceHover"  Color="#2B2825"/>

    <SolidColorBrush x:Key="Line"          Color="#332F2B"/>
    <SolidColorBrush x:Key="LineStrong"    Color="#4A443D"/>

    <SolidColorBrush x:Key="Ink"           Color="#EBE6DE"/>
    <SolidColorBrush x:Key="InkMuted"      Color="#A69E93"/>
    <SolidColorBrush x:Key="InkFaint"      Color="#786F65"/>

    <SolidColorBrush x:Key="Accent"        Color="#7C9AB6"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#8FAAC4"/>
    <SolidColorBrush x:Key="AccentSoft"    Color="#26303A"/>
    <SolidColorBrush x:Key="OnAccent"      Color="#14191E"/>

    <SolidColorBrush x:Key="Running"  Color="#71A96B"/>
    <SolidColorBrush x:Key="Starting" Color="#CBA055"/>
    <SolidColorBrush x:Key="External" Color="#8E99CE"/>
    <SolidColorBrush x:Key="Crashed"  Color="#C86F61"/>
    <SolidColorBrush x:Key="Stopped"  Color="#645C54"/>

    <SolidColorBrush x:Key="WarnBg"   Color="#2C2517"/>
    <SolidColorBrush x:Key="WarnLine" Color="#55482A"/>
    <SolidColorBrush x:Key="WarnInk"  Color="#D8B76F"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================================================
         Text
         ============================================================ -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
    </Style>

    <!-- ============================================================
         Buttons
         ============================================================ -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
                            <Setter TargetName="b" Property="Background" Value="Transparent"/>
                            <Setter TargetName="b" Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Inputs
         ============================================================ -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonoField" TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>

    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- ============================================================
         Status
         ============================================================ -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{StaticResource Stopped}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKey}" Value="Running">
                <Setter Property="Fill" Value="{StaticResource Running}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="Starting">
                <Setter Property="Fill" Value="{StaticResource Starting}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="External">
                <Setter Property="Fill" Value="{StaticResource External}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="Crashed">
                <Setter Property="Fill" Value="{StaticResource Crashed}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusRing" TargetType="Ellipse">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKey}" Value="Running">
                <Setter Property="Stroke" Value="#3C5439"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="Starting">
                <Setter Property="Stroke" Value="#63502A"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="External">
                <Setter Property="Stroke" Value="#474C68"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="Crashed">
                <Setter Property="Stroke" Value="#653830"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKey}" Value="Running">
                <Setter Property="Foreground" Value="{StaticResource Running}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="Starting">
                <Setter Property="Foreground" Value="{StaticResource Starting}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="External">
                <Setter Property="Foreground" Value="{StaticResource External}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey}" Value="Crashed">
                <Setter Property="Foreground" Value="{StaticResource Crashed}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PortChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPortConflict}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/>
                <Setter Property="Background" Value="{StaticResource WarnBg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Scrollbars
         ============================================================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#443E38" CornerRadius="4" Margin="3,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="9,6"/>
    </Style>

    <!-- The card start/stop pair. These live in the theme rather than the view because
         BasedOn cannot take a DynamicResource, so a view-local style would freeze
         against whichever theme happened to be loaded first. -->
    <Style x:Key="CardStartButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanStop}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRemote}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardStopButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanStop}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
