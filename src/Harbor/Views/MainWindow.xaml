<Window x:Class="Harbor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Harbor.ViewModels"
        Title="Harbor"
        Icon="/harbor.png"
        Height="800" Width="1240"
        MinHeight="600" MinWidth="980"
        Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- The whole card is one button, so a click anywhere selects it. The
             start/stop button nested inside still wins its own click. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="card" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the System / Light / Dark control. Tag carries the
             "is this the active mode" flag so the trigger can fill it. -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="seg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/harbor.png" Width="34" Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"/>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Harbor" Style="{DynamicResource H1}"/>
                        <TextBlock Text="{Binding SummaryText}" FontSize="11.5"
                                   Foreground="{DynamicResource InkMuted}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" MaxWidth="300" HorizontalAlignment="Right" Margin="0,0,14,0">
                    <TextBox Style="{DynamicResource Field}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"/>
                    <TextBlock Text="Search name, port, command"
                               Foreground="{DynamicResource InkFaint}" FontSize="13"
                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="2" Margin="0,0,8,0"
                            ToolTip="Appearance. System follows the Windows setting.">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="System" Style="{DynamicResource Segment}"
                                    Tag="{Binding ThemeSystemState}"
                                    Command="{Binding SetThemeCommand}" CommandParameter="System"/>
                            <Button Content="Light" Style="{DynamicResource Segment}"
                                    Tag="{Binding ThemeLightState}"
                                    Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                            <Button Content="Dark" Style="{DynamicResource Segment}"
                                    Tag="{Binding ThemeDarkState}"
                                    Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Categories" Style="{DynamicResource GhostButton}"
                            Command="{Binding ManageCategoriesCommand}" Margin="0,0,8,0"
                            ToolTip="Add, rename, reorder or delete the sections in this list"/>
                    <Button Content="Stop all" Style="{DynamicResource GhostButton}"
                            Command="{Binding StopAllCommand}" Margin="0,0,8,0"
                            ToolTip="Stop every server Harbor started"/>
                    <Button Content="Config" Style="{DynamicResource GhostButton}"
                            Command="{Binding OpenConfigFolderCommand}" Margin="0,0,8,0"
                            ToolTip="Open the folder holding servers.json"/>
                    <Button Content="Add server" Style="{DynamicResource AccentButton}"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Port conflict banner ================= -->
        <Border Grid.Row="1" Background="{DynamicResource WarnBg}"
                BorderBrush="{DynamicResource WarnLine}" BorderThickness="0,0,0,1"
                Padding="20,9"
                Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ConflictWarning}" FontSize="12"
                       Foreground="{DynamicResource WarnInk}" TextWrapping="Wrap"/>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="415" MinWidth="340"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Categories and servers ========== -->
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,10,12,16">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">

                                    <!-- Category header -->
                                    <Grid Margin="2,8,4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Style="{DynamicResource Label}" Margin="0"/>
                                        <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource Line}"
                                                   VerticalAlignment="Center" Margin="10,1,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                   Foreground="{DynamicResource InkFaint}" FontSize="10.5"
                                                   FontFamily="{DynamicResource MonoFont}"/>
                                    </Grid>

                                    <!-- Servers in this category -->
                                    <ItemsControl ItemsSource="{Binding Servers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{DynamicResource CardButton}"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Ellipse Style="{DynamicResource StatusRing}"/>
                                                            <Ellipse Style="{DynamicResource StatusDot}"/>
                                                        </Grid>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Body}"
                                                                       FontWeight="SemiBold" FontSize="13.5"
                                                                       HorizontalAlignment="Left"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding StatusText}" Style="{DynamicResource StatusLabel}"/>
                                                                <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource InkFaint}"/>
                                                                <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                                                                           Foreground="{DynamicResource InkMuted}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Style="{DynamicResource PortChip}" Margin="8,0,8,0">
                                                            <TextBlock Text="{Binding Port}" FontFamily="{DynamicResource MonoFont}"
                                                                       FontSize="11.5" Foreground="{DynamicResource InkMuted}"/>
                                                        </Border>

                                                        <Grid Grid.Column="3">
                                                            <Button Style="{DynamicResource CardStartButton}"
                                                                    Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" ToolTip="Start">
                                                                <Button.Content>
                                                                    <Path Data="M 0,0 L 9,5.5 L 0,11 Z" Fill="{DynamicResource Running}" Margin="2,0,0,0"/>
                                                                </Button.Content>
                                                            </Button>

                                                            <Button Style="{DynamicResource CardStopButton}"
                                                                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" ToolTip="Stop">
                                                                <Button.Content>
                                                                    <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Crashed}"/>
                                                                </Button.Content>
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty category: still visible, so the category reads as a thing you own -->
                                    <Border Background="Transparent" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" CornerRadius="8" Padding="13,12"
                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Nothing here yet"
                                                   Foreground="{DynamicResource InkFaint}" FontSize="11.5"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No servers yet" Style="{DynamicResource Body}"
                               FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add one and Harbor will remember the command, folder and port."
                               Foreground="{DynamicResource InkFaint}" FontSize="11.5"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource Line}"/>

            <!-- ========== Detail ========== -->
            <Grid Grid.Column="2" DataContext="{Binding Selected}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,20,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Grid Margin="0,0,11,0" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource StatusRing}" Width="20" Height="20"/>
                            <Ellipse Style="{DynamicResource StatusDot}" Width="9" Height="9"/>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Style="{DynamicResource H1}" FontSize="18"/>
                        <Border Style="{DynamicResource PortChip}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource StatusLabel}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Url}" Style="{DynamicResource Mono}" Margin="31,7,0,0"/>

                    <!-- IsEnabled is bound straight to the view model rather than left to
                         CanExecute, which lags a selection change until the next requery. -->
                    <StackPanel Orientation="Horizontal" Margin="31,15,0,0">
                        <Button Content="Start" Style="{DynamicResource AccentButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanStart}"
                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Stop" Style="{DynamicResource GhostButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanStop}"
                                Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Open in browser" Style="{DynamicResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Folder" Style="{DynamicResource GhostButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsLocal}"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Rectangle Width="1" Fill="{DynamicResource Line}" Margin="4,3,12,3"/>
                        <Button Content="Edit" Style="{DynamicResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Remove" Style="{DynamicResource QuietButton}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="24,20,24,0" Padding="17,15"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="CATEGORY" Style="{DynamicResource Label}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Group}"
                                   Style="{DynamicResource Body}" Margin="0,-2,0,10"/>

                        <!-- Command and working dir are meaningless for monitor-only entries. -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="COMMAND" Style="{DynamicResource Label}"
                                   Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Command, Mode=OneWay}"
                                  IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                  Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource MonoFont}"
                                  FontSize="12" Padding="0" Margin="0,-2,0,10" TextWrapping="Wrap"
                                  Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="WORKING DIR" Style="{DynamicResource Label}"
                                   Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding WorkingDirectory, Mode=OneWay}"
                                  IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                  Foreground="{DynamicResource InkMuted}" FontFamily="{DynamicResource MonoFont}"
                                  FontSize="12" Padding="0" Margin="0,-2,0,10" TextWrapping="Wrap"
                                  Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ENDPOINT" Style="{DynamicResource Label}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HostPort}"
                                   Style="{DynamicResource Mono}" Margin="0,-2,0,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="NOTES" Style="{DynamicResource Label}"
                                   Visibility="{Binding Notes, Converter={StaticResource StringToVis}}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Notes}"
                                   Style="{DynamicResource Body}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMuted}" Margin="0,-2,0,0"
                                   Visibility="{Binding Notes, Converter={StaticResource StringToVis}}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="24,18,24,22"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource SurfaceSunken}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0" Padding="15,8">
                            <TextBlock Text="OUTPUT" Style="{DynamicResource Label}" Margin="0"/>
                        </Border>

                        <ScrollViewer x:Name="LogScroll" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Padding="15,11">
                            <ItemsControl ItemsSource="{Binding Log}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{Binding IsError, Converter={StaticResource LogBrush}}"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="11.5" TextWrapping="NoWrap" Margin="0,0,0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   Foreground="{DynamicResource InkFaint}" FontSize="11.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Text" Value="No output yet. Press Start."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Log.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRemote}" Value="True">
                                            <Setter Property="Text"
                                                    Value="Monitor only. Harbor watches this port but does not launch it."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
