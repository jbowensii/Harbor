<Window x:Class="Harbor.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        Background="{DynamicResource Canvas}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="PromptText" Style="{DynamicResource Label}"/>
        <TextBox x:Name="Input" Style="{DynamicResource Field}" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{DynamicResource GhostButton}"
                    Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
            <Button Content="OK" Style="{DynamicResource AccentButton}"
                    IsDefault="True" Click="OnOk" MinWidth="76"/>
        </StackPanel>
    </StackPanel>
</Window>
