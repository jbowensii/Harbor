<Window x:Class="Harbor.Views.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categories"
        Width="520" Height="560"
        Background="{DynamicResource Canvas}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel>
                <TextBlock Text="Categories" Style="{DynamicResource H1}"/>
                <TextBlock Text="Sections in the server list. Order here is the order on screen, and a category with nothing in it still shows."
                           Foreground="{DynamicResource InkMuted}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" Grid.Column="0" x:Name="List"
                     Style="{DynamicResource PlainList}"
                     Padding="4"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource Body}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CountLabel}"
                                       Foreground="{DynamicResource InkFaint}" FontSize="11.5"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                <Button Content="Move up" Style="{DynamicResource GhostButton}" Width="96"
                        Margin="0,0,0,6" Click="OnMoveUp"/>
                <Button Content="Move down" Style="{DynamicResource GhostButton}" Width="96"
                        Margin="0,0,0,6" Click="OnMoveDown"/>
                <Button Content="Rename" Style="{DynamicResource GhostButton}" Width="96"
                        Margin="0,0,0,6" Click="OnRename"/>
                <Button Content="Delete" Style="{DynamicResource GhostButton}" Width="96"
                        Click="OnDelete"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="NewBox" Style="{DynamicResource Field}"
                         KeyDown="OnNewBoxKey"/>
                <Button Grid.Column="1" Content="Add category" Style="{DynamicResource GhostButton}"
                        Margin="8,0,0,0" Click="OnAdd"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="22,14" Margin="0,18,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Crashed}"
                           FontSize="11.5" VerticalAlignment="Center"
                           HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="280"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource GhostButton}"
                            Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                    <Button Content="Done" Style="{DynamicResource AccentButton}"
                            IsDefault="True" Click="OnDone" MinWidth="84"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
