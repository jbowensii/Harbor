<Window x:Class="Harbor.Views.EditServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server"
        Width="640" SizeToContent="Height"
        MinWidth="560"
        Background="{DynamicResource Canvas}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="22,15">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="Add server" Style="{DynamicResource H1}"/>
                <TextBlock Text="Harbor runs the command through cmd.exe, so npm, py, python, dotnet, uvicorn and .bat all work exactly as they do in a terminal."
                           Foreground="{DynamicResource InkMuted}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Fields -->
        <StackPanel Grid.Row="1" Margin="22,18,22,4">

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="NAME" Style="{DynamicResource Label}"/>
                <TextBox   Grid.Row="1" Grid.Column="0" x:Name="NameBox" Style="{DynamicResource Field}"/>

                <!-- Editable: pick an existing category or type a new one, which is created on save. -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="CATEGORY" Style="{DynamicResource Label}"/>
                <ComboBox  Grid.Row="1" Grid.Column="2" x:Name="GroupBox" Style="{DynamicResource Combo}"
                           IsEditable="True"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="TYPE" Style="{DynamicResource Label}"/>
                <ComboBox  Grid.Row="1" Grid.Column="4" x:Name="KindBox" Style="{DynamicResource Combo}">
                    <ComboBoxItem Content="Local (launch it)"/>
                    <ComboBoxItem Content="Remote (watch only)"/>
                </ComboBox>
            </Grid>

            <TextBlock Text="COMMAND" Style="{DynamicResource Label}"/>
            <TextBox x:Name="CommandBox" Style="{DynamicResource MonoField}" Margin="0,0,0,4"/>
            <TextBlock x:Name="CommandHint"
                       Text="e.g.  npm run dev     python scripts/dev_server.py     uvicorn app.main:app --port 8000"
                       Foreground="{DynamicResource InkFaint}" FontFamily="{DynamicResource MonoFont}"
                       FontSize="10.5" Margin="1,0,0,14" TextWrapping="Wrap"/>

            <TextBlock Text="WORKING DIRECTORY" Style="{DynamicResource Label}"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="DirBox" Style="{DynamicResource MonoField}"/>
                <Button  Grid.Column="1" Content="Browse" Style="{DynamicResource GhostButton}"
                         Margin="8,0,0,0" Click="OnBrowse"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="HOST" Style="{DynamicResource Label}"/>
                <TextBox   Grid.Row="1" Grid.Column="0" x:Name="HostBox" Style="{DynamicResource MonoField}"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="PORT" Style="{DynamicResource Label}"/>
                <TextBox   Grid.Row="1" Grid.Column="2" x:Name="PortBox" Style="{DynamicResource MonoField}"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="URL PATH" Style="{DynamicResource Label}"/>
                <TextBox   Grid.Row="1" Grid.Column="4" x:Name="PathBox" Style="{DynamicResource MonoField}"/>
            </Grid>

            <TextBlock Text="ENVIRONMENT   (one KEY=VALUE per line, optional)" Style="{DynamicResource Label}"/>
            <TextBox x:Name="EnvBox" Style="{DynamicResource MonoField}"
                     AcceptsReturn="True" MinHeight="54" MaxHeight="110"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

            <TextBlock Text="NOTES" Style="{DynamicResource Label}"/>
            <TextBox x:Name="NotesBox" Style="{DynamicResource Field}"
                     AcceptsReturn="True" MinHeight="44" MaxHeight="90"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

            <CheckBox x:Name="OpenBrowserBox" Style="{DynamicResource Check}"
                      Content="Open the URL in my browser after starting"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="22,13" Margin="0,18,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Crashed}"
                           FontSize="11.5" VerticalAlignment="Center"
                           HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="360"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource GhostButton}"
                            Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                    <Button Content="Save" Style="{DynamicResource AccentButton}"
                            IsDefault="True" Click="OnSave" MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
